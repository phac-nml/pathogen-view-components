{
  "name": "pathogen_view_components",
  "version": "0.1.0",
  "description": "Stimulus controllers for Pathogen ViewComponents library",
  "main": "app/assets/javascripts/pathogen_view_components.js",
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "format": "prettier --write . && eslint app/assets/javascripts test/javascript --fix && pnpm herb:lint:fix && pnpm herb:format",
    "format:changed": "prettier --write . && eslint app/assets/javascripts test/javascript --fix && pnpm herb:lint:fix && pnpm herb:format",
    "herb:format": "herb-format app demo/app test/components/previews",
    "herb:format:check": "herb-format --check app demo/app test/components/previews",
    "herb:lint": "herb-lint",
    "herb:lint:fix": "herb-lint --fix",
    "test": "vitest run",
    "test:unit": "vitest run test/javascript",
    "test:coverage": "vitest run --coverage",
    "test:coverage:strict": "VITEST_STRICT_COVERAGE=1 vitest run --coverage",
    "lint": "prettier --check . && eslint app/assets/javascripts test/javascript && pnpm herb:lint && pnpm herb:format:check",
    "lint:fix": "prettier --write . && eslint app/assets/javascripts test/javascript --fix && pnpm herb:lint:fix && pnpm herb:format",
    "build:css": "node scripts/build-pathogen-tailwind.mjs",
    "build:css:check": "node scripts/build-pathogen-tailwind.mjs --check",
    "build:css:watch": "node scripts/watch-pathogen-css.mjs",
    "build:js": "node scripts/build-demo-javascript.mjs",
    "build:js:watch": "node scripts/build-demo-javascript.mjs --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@herb-tools/formatter": "^0.10.3",
    "@herb-tools/linter": "^0.10.4",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "axe-core": "^4.13.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@hotwired/stimulus": "^3.0.0",
    "uuid": "^14.0.2"
  },
  "peerDependencies": {
    "@hotwired/turbo-rails": "^8.0.0"
  },
  "license": "MIT",
  "msw": {
    "workerDirectory": [
      "demo/public"
    ]
  }
}
