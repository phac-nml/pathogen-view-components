<!DOCTYPE html>

<% lookbook_theme = params.dig(:lookbook, :display, :theme).to_s == 'dark' ? 'dark' : 'light' %>

<html class="<%= 'dark' if lookbook_theme == 'dark' %>" data-theme="<%= lookbook_theme %>">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= stylesheet_link_tag "pathogen_view_components" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lookbook_preview" %>
    <%= javascript_include_tag "lookbook_preview", type: "module", "data-turbo-track": "reload" %>

    <%#
      Demo-only anti-flash shim. In a real host, place `pathogen_sidebar_boot_tag`
      in the document <head> (next to the dark-mode check) so persisted sidebar
      state is applied before first paint. Preview scenarios render layout-less,
      so their `content_for :head` can't reach here; this generic scan mirrors the
      helper for whichever sidebar a preview shows.
    %>

    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var desktop = window.matchMedia("(min-width: 80rem)").matches;
        document.documentElement.setAttribute(
          "data-pathogen-sidebar-viewport",
          desktop ? "desktop" : "mobile"
        );

        var readDesktopPreference = function (sidebarId) {
          if (!desktop) return "false";

          var key = "pathogen.sidebar." + (sidebarId || "sidebar") + ".open";
          var value = "true";
          try {
            var stored = window.localStorage.getItem(key);
            if (stored === "false" || stored === "true") value = stored;
          } catch (error) {
            value = "true";
          }
          return value;
        };

        var applyState = function (root) {
          var sidebars = root.matches && root.matches("[data-pathogen-sidebar-id]")
            ? [root]
            : root.querySelectorAll("[data-pathogen-sidebar-id]");

          for (var i = 0; i < sidebars.length; i++) {
            var sidebar = sidebars[i];
            var sidebarId = sidebar.getAttribute("data-pathogen-sidebar-id") || "sidebar";
            var value = readDesktopPreference(sidebarId);

            sidebar.setAttribute("data-pathogen-sidebar-boot-open", value);
            sidebar.setAttribute(
              "data-pathogen-sidebar-boot-viewport",
              desktop ? "desktop" : "mobile"
            );
          }
        };

        applyState(document);

        var observer = new MutationObserver(function (records) {
          for (var i = 0; i < records.length; i++) {
            var record = records[i];
            for (var j = 0; j < record.addedNodes.length; j++) {
              var node = record.addedNodes[j];
              if (node.nodeType === Node.ELEMENT_NODE) applyState(node);
            }
          }
        });

        observer.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener(
          "DOMContentLoaded",
          function () {
            observer.disconnect();
          },
          { once: true }
        );

        var firstSidebar = document.querySelector("[data-pathogen-sidebar-id]");
        var htmlValue = readDesktopPreference(firstSidebar && firstSidebar.getAttribute("data-pathogen-sidebar-id"));
        document.documentElement.setAttribute("data-pathogen-sidebar-open", htmlValue);
      })();
    </script>

    <%= yield :head %>
  </head>

  <body class="min-h-screen bg-[var(--pvc-color-surface-muted)] p-4 text-[var(--pvc-color-text)]">
    <%= yield %>
  </body>
</html>
