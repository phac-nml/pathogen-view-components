<!doctype html>
<html lang="en"<% if theme == 'dark' %> class="dark"<% end %>>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> — <%= theme %></title>
    <link rel="stylesheet" href="./pathogen.css">
    <style>
      html { color-scheme: <%= theme %>; }
      body {
        margin: 0;
        padding: 1rem;
        background: var(--pvc-color-surface);
        color: var(--pvc-color-text);
        font-family: system-ui, sans-serif;
      }
    </style>
    <script type="module" src="./application.js"></script>
    <script type="module">
      // Grow the embedding iframe with its content so narrow or zoomed previews never clip.
      const frame = window.frameElement;
      if (frame) {
        new ResizeObserver(() => {
          const border = frame.offsetHeight - frame.clientHeight;
          frame.style.height = `${Math.ceil(document.body.getBoundingClientRect().height) + border}px`;
        }).observe(document.body);
      }
    </script>
  </head>
  <body><%= rendered %></body>
</html>
