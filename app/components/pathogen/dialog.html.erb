<%= tag.div(**root_attributes) do %>
  <%= trigger if trigger? %>

  <%= tag.dialog(**dialog_attributes) do %>
    <div class="pathogen-dialog__panel" data-pathogen--dialog-target="panel">
      <header class="pathogen-dialog__header" data-pathogen--dialog-target="header">
        <div class="pathogen-dialog__heading min-w-0 flex-1">
          <%= render Pathogen::Typography::Heading.new(
            level: heading_level,
            id: title_id,
            class: "pathogen-dialog__title",
            tabindex: -1,
            data: { "pathogen--dialog-target" => "title" }) do %>
            <%= title %>
          <% end %>

          <% if description.present? %>
            <%= tag.p(description, id: description_id, class: "pathogen-dialog__description") %>
          <% end %>
        </div>

        <%= render Pathogen::Button.new(
          type: :button,
          tone: :neutral,
          emphasis: :ghost,
          size: :medium,
          icon_only: true,
          text: t(".close_label"),
          class: "pathogen-dialog__close",
          data: { action: "click->pathogen--dialog#requestClose" }
        ) do |button| %>
          <% button.with_leading_visual do %>
            <svg
              class="size-5"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
            </svg>
          <% end %>
        <% end %>
      </header>

      <div class="pathogen-dialog__body" data-pathogen--dialog-target="body" data-pathogen-dialog-body>
        <div class="pathogen-dialog__content" data-pathogen--dialog-target="content"><%= content %></div>
      </div>

      <% if footer? %>
        <footer class="pathogen-dialog__footer" data-pathogen--dialog-target="footer"><%= footer %></footer>
      <% end %>
    </div>
  <% end %>
<% end %>
