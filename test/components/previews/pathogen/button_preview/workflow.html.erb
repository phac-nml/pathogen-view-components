<div class="max-w-4xl p-4">
  <section class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface)]">
    <div class="p-4 sm:p-6">
      <%= render(Pathogen::Typography::Supporting.new(variant: :muted, size: :meta)) { 'Enteric surveillance / Specimens' } %>
      <%= render(Pathogen::Typography::Heading.new(level: 2, class: 'mt-2')) { 'Specimen details' } %>
      <%= render(Pathogen::Typography::Supporting.new(variant: :muted, class: 'mt-1')) { 'SP-2026-0142' } %>

      <div class="my-6 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="button-workflow-name" class="mb-2 block text-[length:var(--type-control)] font-semibold">Specimen name</label>

          <input
            id="button-workflow-name"
            value="SP-2026-0142"
            class="
              min-h-[var(--pvc-control-size-medium)] w-full min-w-0 rounded-[var(--pvc-radius-control)] border
              border-[var(--pvc-color-border-strong)] bg-[var(--pvc-color-surface)] px-3 py-2
              text-[length:var(--type-control)] text-[var(--pvc-color-text)] focus-visible:outline-2
              focus-visible:outline-offset-2 focus-visible:outline-[var(--pvc-color-focus)]
            "
          >
        </div>

        <div>
          <label for="button-workflow-protocol" class="mb-2 block text-[length:var(--type-control)] font-semibold">Protocol</label>

          <select
            id="button-workflow-protocol"
            class="
              min-h-[var(--pvc-control-size-medium)] w-full min-w-0 rounded-[var(--pvc-radius-control)] border
              border-[var(--pvc-color-border-strong)] bg-[var(--pvc-color-surface)] px-3 py-2
              text-[length:var(--type-control)] text-[var(--pvc-color-text)] focus-visible:outline-2
              focus-visible:outline-offset-2 focus-visible:outline-[var(--pvc-color-focus)]
            "
          >
            <%= options_for_select(['Whole genome sequencing', 'Quality control']) %>
          </select>
        </div>
      </div>

      <div class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)]">
        <div class="border-b border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface-muted)] p-3">
          <%= render Pathogen::Toolbar.new(label: 'Sequence file actions') do %>
            <%= render(Pathogen::Typography::Supporting.new(tag: :span, class: 'font-semibold')) { 'Sequence files' } %>
            <%= render Pathogen::Toolbar::Spacer.new %>

            <%= render Pathogen::Toolbar::Group.new do %>
              <%= render Pathogen::Toolbar::Button.new(emphasis: :ghost, text: 'Download') do |button| %>
                <% button.with_leading_visual { icon('download-simple', class: 'size-4') } %>
              <% end %>

              <%= render Pathogen::Toolbar::Button.new(tone: :primary, emphasis: :soft, text: 'Add files') do |button| %>
                <% button.with_leading_visual { icon('plus', class: 'size-4') } %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <ul class="divide-y divide-[var(--pvc-color-border)]">
          <% %w[0142_R1.fastq.gz 0142_R2.fastq.gz].each do |filename| %>
            <li class="flex flex-wrap items-center justify-between gap-2 px-3 py-3">
              <%= render(Pathogen::Typography::Supporting.new(tag: :span)) { filename } %>

              <div class="flex items-center gap-4">
                <span
                  class="
                    inline-flex items-center gap-1 rounded-full
                    bg-[color-mix(in_oklab,var(--pvc-color-success)_14%,var(--pvc-color-surface))] px-2 py-0.5
                    text-[length:var(--type-meta)] font-medium text-[var(--pvc-color-success-strong)]
                  "
                >
                  <%= icon('check', class: 'size-3') %> Ready
                </span>

                <%= render Pathogen::Button.new(size: :small, emphasis: :ghost, text: 'View', aria: { label: "View #{filename}" }) %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <%= render(Pathogen::Typography::Supporting.new(variant: :muted, size: :meta, class: 'mt-4', id: 'button-workflow-unavailable')) { 'Submit run is unavailable until the specimen has been reviewed.' } %>

      <div class="mt-2 flex flex-wrap gap-2">
        <%= render Pathogen::Button.new(size: :small, text: 'Export', disabled: true) %>
        <%= render Pathogen::Button.new(size: :small, tone: :primary, emphasis: :solid, text: 'Submit run', aria_disabled: true, aria: { describedby: 'button-workflow-unavailable' }) %>
      </div>
    </div>

    <div
      class="
        flex flex-wrap items-center justify-between gap-4 rounded-b-[var(--pvc-radius-panel)] border-t
        border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface-muted)] p-4 sm:px-6
      "
    >
      <%= render Pathogen::Button.new(tone: :danger, emphasis: :ghost, text: 'Delete specimen') %>

      <div class="ms-auto flex flex-wrap items-center gap-2" role="group" aria-label="Specimen form actions">
        <%= render Pathogen::Button.new(emphasis: :ghost, text: 'Cancel') %>
        <%= render Pathogen::Button.new(emphasis: :soft, text: 'Save draft') %>
        <%= render Pathogen::Button.new(tone: :primary, emphasis: :solid, text: 'Save changes', class: 'ms-2') %>
      </div>
    </div>
  </section>
</div>
