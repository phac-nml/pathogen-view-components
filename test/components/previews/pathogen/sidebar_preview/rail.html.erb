<div class="space-y-4 p-4">
  <%= pathogen_sidebar_boot_tag(id: 'rail-sidebar') %>

  <%= render Pathogen::Sidebar::Provider.new(id: 'rail-sidebar', open: false, class: 'h-[600px] !min-h-[600px] rounded-[var(--pvc-radius-panel)] border border-[color:var(--pvc-color-border)]') do %>
    <%= render Pathogen::Sidebar.new(id: 'rail-sidebar', label: 'Primary navigation') do %>
      <%= render Pathogen::Sidebar::Header.new do %>
        <%= render Pathogen::Sidebar::Trigger.new %>
      <% end %>

      <%= render Pathogen::Sidebar::Content.new(class: 'items-start') do %>
        <div class="inline-flex items-center gap-2">
          <%= render Pathogen::Button.new(
            icon_only: true,
            size: :small,
            tone: :neutral,
            emphasis: :ghost,
            text: 'Projects'
          ) do |button| %>
            <% button.with_tooltip(text: 'Projects', placement: :right, describe: false) %>

            <% button.with_leading_visual do %>
              <%= pathogen_avatar(label: 'Projects', initials: 'P', size: :xs, decorative: true) %>
            <% end %>
          <% end %>

          <span data-pathogen-sidebar-label="true">Projects</span>
        </div>

        <div class="inline-flex items-center gap-2">
          <%= render Pathogen::Button.new(
            icon_only: true,
            size: :small,
            tone: :neutral,
            emphasis: :ghost,
            text: 'Pipelines'
          ) do |button| %>
            <% button.with_tooltip(text: 'Pipelines', placement: :right, describe: false) %>

            <% button.with_leading_visual do %>
              <%= pathogen_avatar(label: 'Pipelines', initials: 'R', size: :xs, decorative: true) %>
            <% end %>
          <% end %>

          <span data-pathogen-sidebar-label="true">Pipelines</span>
        </div>
      <% end %>

      <%= render Pathogen::Sidebar::Footer.new(class: 'items-start text-left') do %>
        <div class="inline-flex items-center gap-2">
          <%= pathogen_avatar(label: 'Analyst Jane', initials: 'AJ', size: :small) %>

          <span
            data-pathogen-sidebar-label="true"
            class="text-[length:var(--type-meta)] text-[color:var(--pvc-color-text-muted)]"
          >
            Account
          </span>
        </div>
      <% end %>
    <% end %>

    <%= render Pathogen::Sidebar::Inset.new do %>
      <main class="p-4">
        <%= pathogen_heading(level: 3) { 'Rail mode preview' } %>
        <%= pathogen_supporting(variant: :muted) { 'Desktop preference starts closed and restores icon rail width.' } %>
      </main>
    <% end %>
  <% end %>
</div>
