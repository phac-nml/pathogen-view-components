<div class="space-y-4 p-4">
  <%= render Pathogen::Sidebar::Provider.new(id: 'overview-sidebar', class: 'h-[600px] !min-h-[600px] rounded-[var(--pvc-radius-panel)] border border-[color:var(--pvc-color-border)]') do %>
    <%= render Pathogen::Sidebar.new(id: 'overview-sidebar', label: 'Primary navigation') do %>
      <%= render Pathogen::Sidebar::Header.new do %>
        <%= render Pathogen::Sidebar::Trigger.new %>
        <span data-pathogen-sidebar-label="true" class="text-[length:var(--type-control)] font-semibold">Pathogen</span>
      <% end %>

      <%= render Pathogen::Sidebar::Content.new do %>
        <%= render Pathogen::Sidebar::Group.new(label: 'Run navigation') do %>
          <%= render Pathogen::Sidebar::Item.new(label: 'Run overview', href: '#run-overview', current: true, tooltip: true) do |item| %>
            <% item.with_leading_visual { icon('chart-bar', class: 'size-4') } %>
          <% end %>

          <%= render Pathogen::Sidebar::Item.new(label: 'Samples', href: '#samples', tooltip: true) do |item| %>
            <% item.with_leading_visual { icon('flask', class: 'size-4') } %>
          <% end %>

          <%= render Pathogen::Sidebar::Item.new(label: 'Quality control', href: '#quality-control', tooltip: true) do |item| %>
            <% item.with_leading_visual { icon('check-circle', class: 'size-4') } %>
          <% end %>

          <%= render Pathogen::Sidebar::Item.new(label: 'Settings', open: true, tooltip: true) do |item| %>
            <% item.with_leading_visual { icon('gear', class: 'size-4') } %>

            <%= render Pathogen::Sidebar::Item.new(label: 'Workflow rules', href: '#workflow-rules') do |child| %>
              <% child.with_leading_visual { icon('sliders', class: 'size-4') } %>
            <% end %>

            <%= render Pathogen::Sidebar::Item.new(label: 'Access control', href: '#access-control') do |child| %>
              <% child.with_leading_visual { icon('lock-key', class: 'size-4') } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= render Pathogen::Sidebar::Footer.new do %>
        <span
          data-pathogen-sidebar-label="true"
          class="text-[length:var(--type-meta)] text-[color:var(--pvc-color-text)]"
        >
          Signed in as analyst@example.org
        </span>
      <% end %>
    <% end %>

    <%= render Pathogen::Sidebar::Inset.new do %>
      <div class="flex items-center gap-2 border-b border-[color:var(--pvc-color-border)] p-3 xl:hidden">
        <%= render Pathogen::Sidebar::Trigger.new %>
        <span class="text-[length:var(--type-control)] font-semibold">Run detail</span>
      </div>

      <main class="space-y-2 p-4">
        <%= pathogen_heading(level: 2, id: 'run-overview') { 'Run overview' } %>

        <%= pathogen_heading(level: 3, id: 'samples') { 'Samples' } %>
        <%= pathogen_heading(level: 3, id: 'quality-control') { 'Quality control' } %>
        <%= pathogen_heading(level: 3, id: 'workflow-rules') { 'Workflow rules' } %>
        <%= pathogen_heading(level: 3, id: 'access-control') { 'Access control' } %>

        <%= pathogen_supporting do %>
          Sequencing run RUN-2026-0812 is processing 48 samples. Twelve samples have completed quality control.
        <% end %>
      </main>
    <% end %>
  <% end %>
</div>
