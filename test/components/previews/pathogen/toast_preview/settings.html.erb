<%# herb:formatter ignore %>

<div class="flex max-w-xl flex-col gap-6 p-4">
  <section>
    <%= render(Pathogen::Typography::Heading.new(level: 3, class: "mb-2")) { "Notification timing preference" } %>

    <%= render(Pathogen::Typography::Supporting.new(variant: :muted, class: "mb-4")) do %>
      Status toasts auto-dismiss, so hosts must let users extend or disable that timing to satisfy
      <%= render(Pathogen::Typography::Code.new) { "WCAG 2.2.1" } %>. This control writes
      <%= render(Pathogen::Typography::Code.new) { "localStorage['pathogen.toast.durationMs']" } %>, which the toaster reads:
      <%= render(Pathogen::Typography::Code.new) { "20000" } %> extends the timer and <%= render(Pathogen::Typography::Code.new) { "forever" } %> promotes status
      toasts to dismissible dialogs.
    <% end %>

    <div
      class="
        rounded-(--pvc-radius-panel) border border-(--pvc-color-border)
        bg-(--pvc-color-surface-raised) p-4
      "
    >
      <%= render Pathogen::ToastSettings.new %>
    </div>
  </section>
</div>
